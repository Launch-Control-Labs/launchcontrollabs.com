# Resend API key — get one at https://resend.com
RESEND_API_KEY=re_your_api_key_here

# Sender address — must be a verified domain in Resend, or use onboarding@resend.dev for testing
CONTACT_EMAIL_FROM=onboarding@resend.dev

# Comma-separated list of recipient addresses for contact form notifications
CONTACT_EMAIL_TO=you@example.com
